import gantry_gui
print(gantry_gui.__file__)


from gantry_gui import launch_gui

def main():
    launch_gui()

if __name__ == "__main__":
    main()









import customtkinter as ctk
from gui_functions import (
    set_fan1_duty, set_fan2_duty, toggle_solenoid, toggle_lift,
    toggle_dc1, toggle_dc2, toggle_dc3, toggle_lights, send_gantry_position,
    get_mock_position, get_mock_fan_data
)

def launch_gui():
    ctk.set_default_color_theme("blue")
    ctk.set_appearance_mode("light")

    root = ctk.CTk()
    root.geometry("600x700")
    root.title("Gantry Control")

    light_state = {"on": False}

    def _update_entry(widget, value):
        widget.delete(0, "end")
        widget.insert(0, str(value))

    def refresh():
        for w in [cur_x, cur_y, cur_z, next_x, next_y, next_z,
                  rpm1_entry, duty1_entry, rpm2_entry, duty2_entry,
                  r_entry, g_entry, b_entry, cur_r_entry, cur_g_entry, cur_b_entry]:
            _update_entry(w, "0")
        combo1.set("0")
        combo2.set("0")
        print("[MOCK] All values reset to 0")

    def query_all_data():
        pos = get_mock_position()
        next_pos = get_mock_position()
        fan1 = get_mock_fan_data()
        fan2 = get_mock_fan_data()

        _update_entry(cur_x, pos["X"])
        _update_entry(cur_y, pos["Y"])
        _update_entry(cur_z, pos["Z"])
        _update_entry(next_x, next_pos["X"])
        _update_entry(next_y, next_pos["Y"])
        _update_entry(next_z, next_pos["Z"])
        _update_entry(rpm1_entry, fan1["RPM"])
        _update_entry(duty1_entry, fan1["Duty"])
        _update_entry(rpm2_entry, fan2["RPM"])
        _update_entry(duty2_entry, fan2["Duty"])

    def sampling_loop():
        if samp_var.get():
            query_all_data()
            root.after(int(samp_spin.get()) * 1000, sampling_loop)

    def apply_rgb(r, g, b):
        _update_entry(cur_r_entry, r)
        _update_entry(cur_g_entry, g)
        _update_entry(cur_b_entry, b)
        print(f"[MOCK] Lights set to RGB ({r}, {g}, {b})")

    def set_rgb():
        if not hasattr(toggle_lights, "state") or not toggle_lights.state:
            print("[INFO] Lights are OFF. Turn them ON to set RGB values.")
            return
        
        try:
            r = max(0, min(255, int(r_entry.get())))
            g = max(0, min(255, int(g_entry.get())))
            b = max(0, min(255, int(b_entry.get())))
            
            #pixels1.fill((r, g, b))
            
            # Update current RGB display entries
            cur_r_entry.delete(0, "end")
            cur_r_entry.insert(0, str(r))
            
            cur_g_entry.delete(0, "end")
            cur_g_entry.insert(0, str(g))
            
            cur_b_entry.delete(0, "end")
            cur_b_entry.insert(0, str(b))
            
            print(f"Set RGB to ({r}, {g}, {b})")
            
        except ValueError:
            print("[ERROR] Invalid RGB input. Please enter integers 0-255.")

    # === Top Controls ===
    top_frame = ctk.CTkFrame(root)
    top_frame.pack(fill="x", pady=5)

    ctk.CTkButton(top_frame, text="Refresh", command=refresh).pack(side="left", padx=5)

    ctrl_var = ctk.BooleanVar()
    ctk.CTkCheckBox(top_frame, text="Enable Control Mode", variable=ctrl_var).pack(side="left", padx=5)

    samp_var = ctk.BooleanVar()
    ctk.CTkCheckBox(top_frame, text="Sampling", variable=samp_var, command=sampling_loop).pack(side="left", padx=5)

    ctk.CTkLabel(top_frame, text="Sampling Time (s):").pack(side="left", padx=5)
    samp_spin = ctk.CTkComboBox(top_frame, values=[str(i) for i in range(1, 11)], width=50)
    samp_spin.set("1")
    samp_spin.pack(side="left", padx=5)

    dark_var = ctk.BooleanVar()
    ctk.CTkCheckBox(top_frame, text="Dark Mode", variable=dark_var,
                    command=lambda: ctk.set_appearance_mode("dark" if dark_var.get() else "light")
                    ).pack(side="left", padx=5)

    # === Gantry Control ===
    gantry_frame = ctk.CTkFrame(root)
    gantry_frame.pack(pady=10)

    ctk.CTkLabel(gantry_frame, text="Gantry Control", font=("Arial", 14, "bold")).grid(row=0, column=0, columnspan=4)
    for i, label in enumerate(["X", "Y", "Z"]):
        ctk.CTkLabel(gantry_frame, text=label).grid(row=1, column=i+1)

    ctk.CTkLabel(gantry_frame, text="Enter Target Position").grid(row=2, column=0)
    x_entry = ctk.CTkEntry(gantry_frame, width=50)
    y_entry = ctk.CTkEntry(gantry_frame, width=50)
    z_entry = ctk.CTkEntry(gantry_frame, width=50)
    x_entry.grid(row=2, column=1)
    y_entry.grid(row=2, column=2)
    z_entry.grid(row=2, column=3)

    def safe_send_position():
        if ctrl_var.get():
            send_gantry_position(x_entry.get(), y_entry.get(), z_entry.get())

    ctk.CTkButton(gantry_frame, text="Send Position", command=safe_send_position).grid(row=2, column=4, padx=5)

    ctk.CTkLabel(gantry_frame, text="Current Position").grid(row=3, column=0)
    cur_x = ctk.CTkEntry(gantry_frame, width=50)
    cur_y = ctk.CTkEntry(gantry_frame, width=50)
    cur_z = ctk.CTkEntry(gantry_frame, width=50)
    cur_x.grid(row=3, column=1)
    cur_y.grid(row=3, column=2)
    cur_z.grid(row=3, column=3)

    ctk.CTkLabel(gantry_frame, text="Next Target").grid(row=4, column=0)
    next_x = ctk.CTkEntry(gantry_frame, width=50)
    next_y = ctk.CTkEntry(gantry_frame, width=50)
    next_z = ctk.CTkEntry(gantry_frame, width=50)
    next_x.grid(row=4, column=1)
    next_y.grid(row=4, column=2)
    next_z.grid(row=4, column=3)

    # === Fan Control ===
    fan_frame = ctk.CTkFrame(root)
    fan_frame.pack(pady=10)

    ctk.CTkLabel(fan_frame, text="Fan Control", font=("Arial", 14, "bold")).grid(row=0, column=0, columnspan=4)

    ctk.CTkLabel(fan_frame, text="RPM").grid(row=1, column=0)
    ctk.CTkLabel(fan_frame, text="Duty%").grid(row=1, column=1)
    rpm1_entry = ctk.CTkEntry(fan_frame, width=70)
    duty1_entry = ctk.CTkEntry(fan_frame, width=70)
    rpm1_entry.grid(row=2, column=0)
    duty1_entry.grid(row=2, column=1)
    combo1 = ctk.CTkComboBox(fan_frame, values=[str(i) for i in range(0, 101, 10)], width=70)
    combo1.set("0")
    combo1.grid(row=3, column=0)

    def safe_set_fan1():
        if ctrl_var.get():
            set_fan1_duty(combo1.get())

    ctk.CTkButton(fan_frame, text="Set Fan 1", width=70, command=safe_set_fan1).grid(row=3, column=1)

    ctk.CTkLabel(fan_frame, text="RPM").grid(row=1, column=2)
    ctk.CTkLabel(fan_frame, text="Duty%").grid(row=1, column=3)
    rpm2_entry = ctk.CTkEntry(fan_frame, width=70)
    duty2_entry = ctk.CTkEntry(fan_frame, width=70)
    rpm2_entry.grid(row=2, column=2)
    duty2_entry.grid(row=2, column=3)
    combo2 = ctk.CTkComboBox(fan_frame, values=[str(i) for i in range(0, 101, 10)], width=70)
    combo2.set("0")
    combo2.grid(row=3, column=2)

    def safe_set_fan2():
        if ctrl_var.get():
            set_fan2_duty(combo2.get())

    ctk.CTkButton(fan_frame, text="Set Fan 2", width=70, command=safe_set_fan2).grid(row=3, column=3)

    # === Toggle Control ===
    toggle_frame = ctk.CTkFrame(root)
    toggle_frame.pack(pady=10)

    ctk.CTkLabel(toggle_frame, text="Toggle Control", font=("Arial", 14, "bold")).grid(row=0, column=0, columnspan=3)

    def update_toggle_status(switch, status_entry, toggle_func, device=None):
        if ctrl_var.get():
            toggle_func()
            is_on = switch.get()
            status_entry.delete(0, "end")
            status_entry.insert(0, "ON" if is_on else "OFF")
            if device == "Lights":
                light_state["on"] = bool(is_on)

    def add_toggle(row, label_text, toggle_func):
        status = ctk.CTkEntry(toggle_frame, width=50)
        status.grid(row=row, column=1, padx=5)
        switch = ctk.CTkSwitch(toggle_frame, text=label_text,
                               command=lambda: update_toggle_status(switch, status, toggle_func, label_text))
        switch.grid(row=row, column=0, sticky="w", padx=5, pady=2)
        return switch, status

    solenoid_sw, solenoid_stat = add_toggle(1, "Solenoid", toggle_solenoid)
    lift_sw, lift_stat = add_toggle(2, "Lift", toggle_lift)
    dc1_sw, dc1_stat = add_toggle(3, "DC Motor 1", toggle_dc1)
    dc2_sw, dc2_stat = add_toggle(4, "DC Motor 2", toggle_dc2)
    dc3_sw, dc3_stat = add_toggle(5, "DC Motor 3", toggle_dc3)
    light_sw, light_stat = add_toggle(6, "Lights", toggle_lights)
    
    
    # === RGB Control ===
    rgb_frame = ctk.CTkFrame(root)
    rgb_frame.pack(pady=10)

    ctk.CTkLabel(rgb_frame, text="RGB Control", font=("Arial", 14, "bold")).grid(row=0, column=0, columnspan=4, pady=(0, 5))

    # Row 1: empty label for alignment + R G B labels
    ctk.CTkLabel(rgb_frame, text="").grid(row=1, column=0)
    ctk.CTkLabel(rgb_frame, text="R").grid(row=1, column=1)
    ctk.CTkLabel(rgb_frame, text="G").grid(row=1, column=2)
    ctk.CTkLabel(rgb_frame, text="B").grid(row=1, column=3)

    # Row 2: RGB entry boxes
    r_entry = ctk.CTkEntry(rgb_frame, width=60)
    g_entry = ctk.CTkEntry(rgb_frame, width=60)
    b_entry = ctk.CTkEntry(rgb_frame, width=60)

    for e in [r_entry, g_entry, b_entry]:
        e.insert(0, "0")

    r_entry.grid(row=2, column=1, padx=5)
    g_entry.grid(row=2, column=2, padx=5)
    b_entry.grid(row=2, column=3, padx=5)

    # Row 3: Current RGB + values
    ctk.CTkLabel(rgb_frame, text="Current RGB:").grid(row=3, column=0, padx=5, pady=(5, 0), sticky="e")

    cur_r_entry = ctk.CTkEntry(rgb_frame, width=60)
    cur_g_entry = ctk.CTkEntry(rgb_frame, width=60)
    cur_b_entry = ctk.CTkEntry(rgb_frame, width=60)

    for e in [cur_r_entry, cur_g_entry, cur_b_entry]:
        e.insert(0, "0")

    cur_r_entry.grid(row=3, column=1, padx=5, pady=(5, 0))
    cur_g_entry.grid(row=3, column=2, padx=5, pady=(5, 0))
    cur_b_entry.grid(row=3, column=3, padx=5, pady=(5, 0))

    # Row 4: Set RGB button
    set_rgb_btn = ctk.CTkButton(rgb_frame, text="Set RGB", width=150, command=set_rgb)
    set_rgb_btn.grid(row=4, column=1, columnspan=3,sticky="ew", pady=5)


    refresh_btn = ctk.CTkButton(top_frame, text="Refresh", command=query_all_data)
    refresh_btn.pack(side="left", padx=5)

    root.mainloop()
