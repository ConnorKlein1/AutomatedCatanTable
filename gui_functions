def toggle_lights():
    if not hasattr(toggle_lights, "state"):
        toggle_lights.state = False  # Initial state OFF
    
    toggle_lights.state = not toggle_lights.state  # Toggle the state
    state_str = "ON" if toggle_lights.state else "OFF"
    
    if toggle_lights.state:
        # Turn lights ON (example green color)
        pixels1.fill((0, 255, 0))  # Green fill")
    else:
        # Turn lights OFF
        pixels1.fill((0, 0, 0)) # All LEDs off"
    
    print(f"Toggling lights {state_str}")
   


def _update_entry(entry_widget, value):
    """Utility to update an entry widget's value"""
    entry_widget.delete(0, "end")
    entry_widget.insert(0, str(value))

def query_all_data(gui):
    """Update GUI with dummy data for testing."""
    # Generate dummy values
    pos = {
        "X": random.randint(0, 100),
        "Y": random.randint(0, 100),
        "Z": random.randint(0, 100)
    }
    next_target = {
        "X": random.randint(0, 100),
        "Y": random.randint(0, 100),
        "Z": random.randint(0, 100)
    }
    fan1 = {
        "RPM": random.randint(500, 2000),
        "Duty": random.randint(0, 100)
    }
    fan2 = {
        "RPM": random.randint(500, 2000),
        "Duty": random.randint(0, 100)
    }

    # Update GUI entries
    _update_entry(gui.cur_x, pos["X"])
    _update_entry(gui.cur_y, pos["Y"])
    _update_entry(gui.cur_z, pos["Z"])

    _update_entry(gui.next_x, next_target["X"])
    _update_entry(gui.next_y, next_target["Y"])
    _update_entry(gui.next_z, next_target["Z"])

    _update_entry(gui.rpm1_entry, fan1["RPM"])
    _update_entry(gui.duty1_entry, fan1["Duty"])

    _update_entry(gui.rpm2_entry, fan2["RPM"])
    _update_entry(gui.duty2_entry, fan2["Duty"])

    print({
        "Current Position": pos,
        "Next Target": next_target,
        "Fan1": fan1
        "Fan2": fan2
    })

def sampling_loop(gui):
    """Run sampling periodically if enabled."""
    if gui.samp_var.get():
        query_all_data(gui)
        try:
            interval = int(gui.samp_spin.get())
        except ValueError:
            interval = 1
        gui.root.after(interval * 1000, lambda: sampling_loop(gui))

